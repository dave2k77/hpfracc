    "forbidden_normalization": [
      "signed_zero",
      "pole_permutation",
      "zero_coefficient_pruning",
      "equivalent_kernel_merging",
      "GL_RL_request_alias_merging"
    ],
    "duplicate_rule": "same ID OR same ID-free content tuple is request-invalid, including equal content under different IDs; same pole count alone is not a duplicate; request alias is not in candidate identity",
    "missing_identity": "if content cannot be authenticated, assessment is UNKNOWN; independently known duplicate IDs still make request invalid",
    "execution_binding": "Separate volatile producer_binding payload SHA recipe in record-schemas.json and schema-control-contract.md; no change to ID-free content identity."
  },
  "resource_accounting": {
    "primitive_unit": "each exact rational add, subtract, multiply, divide, abs, comparison = 1, including comparisons for min/max/qualification and independent checks",
    "shared": "one cumulative counter per request across shared w/g/v/D, every candidate, independent signed/prefix/residual cross-check, all analytic input-gradient Lhat/transpose/objective references and any reruns/mode-specific exact arrays; cache reuse costs zero only when no arithmetic is performed",
    "powers": "rho^0 is literal 1; each subsequent power is one charged multiply. Closed-form binomial cross-check integer multiplications/divisions/comparisons are also charged as rational primitives; no opaque uncharged power/sum/dot.",
    "nonprimitive": "raw IEEE decode, gcd normalization internals, bit-length checks, canonical parse, hashing, allocation and serialization are not rational primitives but are wall/byte bounded; counter is not bit complexity or a peak-memory bound",
    "reservation": "check op_count+1 <= limit BEFORE operation; validate operand bits; normalize/check result bits AFTER operation; integers inside multiplication/GCD may temporarily exceed normalized cap (up to twice operand bits for products)",
    "evidence_coverage": "sum actual raw file byte lengths of ALL per-request input/fit/working and exact arrays, descriptors, hashes, manifests, metadata, command/process logs and failure index, including whitespace/newline/partial files. A compressed file is not a license to omit raw evidence. Frozen shared packet/source files referenced by path+hash need not be recopied; if copied charge full bytes. No uncounted mirror/log.",
    "reservations_bytes": {
      "input_bundle": 262144,
      "failure_index": 524288,
      "remaining_results": 15990784
    },
    "persistence": "Mandatory exact lifecycle in schema-control-contract.md: fresh private per-request root/subdirs, no-follow handle-relative creation/readback and owner/type/inode/containment verification; immutable array no-overwrite, atomic owned index replacement only. Charge all owned temporary/partial/coexisting bytes and cumulative written bytes; both live and cumulative <=16MiB. No deletion/rewrite evasion. Prepersist all quantity, comparison, fit-binding and occurrence dispositions. Whole reserved final index transaction including coexisting files/receipts must fit 512KiB or bounded reservation_exceeded/indeterminate, no numerical work.",
    "watchdog": "Supervisor monotonic clock starts immediately before worker process launch, includes launch/import/decode/arithmetic/export/flush; stops only on confirmed exit. At 60s terminate then bounded 1s grace then kill; timeout is indeterminate regardless of any earlier qualifier. Supervisor writes reserved index/process record after kill; includes grace/kill latency separately, never calls 60s a total elapsed guarantee. Preflight bounded input capture is separately timed/byte-bounded, occurs before launch. Closed phase_timing/process/launch_receipt/supervisor_export define preflight, watchdog, grace, kill-through-confirmed-exit and later index-write intervals without digest/write cycles; unavailable/not-applicable are explicit, zero-wall barrier never released. No 60-second total guarantee.",
    "overflow": "Any work/bit/evidence/watchdog/integrity/completeness exhaustion leaves explicit UNKNOWN and not_evaluated slots for all unfinished admitted IDs; known earlier results remain known but whole request indeterminate. No minimum/no-qualifier claim.",
    "failure_index_layout": "Closed index_slot rows and ALL comparison/binding_check dispositions, occurrence list, process/phase receipt and byte-accounting fields. Full transaction templates must cover initial/final index coexistence and later supervisor export; <=512KiB reservation is not promised feasible for every case. Refuse launch with bounded indeterminate reservation_exceeded when required transaction cannot fit, never omit fields/checks.",
    "output_security_contract": "schema-control-contract.md#output-security-and-byte-accounting-lifecycle"
  },
