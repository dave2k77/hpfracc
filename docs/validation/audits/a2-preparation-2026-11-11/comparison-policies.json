  "input_gradient": {
    "objective": "mean(D_hat**2) over all N*M entries; M=1 for (N,)",
    "signed_weights": "g_hat[-1]=0; w_hat[k]=g_hat[k]-g_hat[k-1], k=0..N-1",
    "L_hat": "N by N lower triangular, L_hat[i,j]=2*w_hat[i-j] if j<=i else 0; acts on each feature independently",
    "exact_target": "2/(N*M) * L_hat.T @ D_hat, retaining input shape",
    "direction": "q=cos(x_base) computed once in target worker dtype; raw q retained, stop_gradient q; never cos(x_perturbed); directional AD=sum(input_AD*q); exact directional target=sum(exact_input_gradient*decoded_q)",
    "fixed_fit": "input perturbations hold alpha/config fixed; each composition must return actual fit arrays, compare identities to same-mode base; exact gradient bound to that mode base actual fit, not borrowed eager arrays"
  },
  "order_gradient": {
    "objective": "mean((dt**(-a) * apply(x, fit(a,fixed_config)))**2)",
    "alpha": "strong scalar shape [] in worker dtype, including every +/- branch and JIT dynamic argument",
    "scale": "dt is strong scalar in same dtype; recompute dt**(-a) INSIDE differentiated objective and each perturbation. 2 is exact only at base a=1/2. dt remains fixed; alpha perturbs.",
    "selection": "outside AD/FD; fix selected pole count and producer config from base, refit at each a; never reselect, never freeze order-dependent coefficients",
    "scope": "differentiate existing finite 400 projected iterations, not an implicit optimizer optimum; only empirical AD/FD observations at perturbed orders, no rational-budget domain extension"
  },
